[Unit]
Description=TT Realty BOK listings sync — scrape, import, and staging DB push
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/javon/Desktop/Real Estate Website Builder
# Load API keys (OpenAI / Google Maps) from project .env — Rails also loads these for local.
EnvironmentFile=-/home/javon/Desktop/Real\x20Estate\x20Website\x20Builder/.env
Environment=RAILS_ENV=development
Environment=BOK_SYNC_DAYS=7
Environment=BOK_SYNC_MAX_DETAILS=250
Environment=BOK_SYNC_DELAY=4
Environment=BOK_SYNC_SKIP_SEARCH=1
Environment=BOK_SYNC_PUSH_STAGING=1
Environment=BOK_APPLY_LISTING_COPY=1
# Address brain: OpenAI (+ Google) enrich weak addresses on create only (never re-reconcile).
Environment=BOK_ADDRESS_BRAIN=1
Environment=ADDRESS_BRAIN_BATCH=12
# After create only: Photon/Nominatim → Overpass → AI forge → Google (never re-reconcile updates).
Environment=BOK_COORD_RECONCILE=1
Environment=BOK_COORD_RECONCILE_SOURCES=deep
Environment=BOK_COORD_RECONCILE_CITY_ONLY=1
# After import: re-apply dual sale/rent tip-price + tag rules across the feed.
Environment=BOK_OFFER_RECONCILE=1
# BOK_SYNC_DAYS is the starting lookback peg and +N expansion step. The scraper
# stores progress_cache.lookback_days and stretches further back when a window
# has no unfinished URLs (completed cache = less refresh of already-fetched pages).
Environment=STAGING_GCP_PROJECT=tt-realty-staging
Environment=STAGING_CLOUDSQL_CONNECTION=tt-realty-staging:us-east1:tt-realty-stg-db
Environment=STAGING_SQL_PROXY_PORT=5433
Environment=PATH=/home/javon/.local/share/google-cloud-sdk/bin:/home/javon/.local/share/mise/shims:/home/javon/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/javon
# Quote the rails binary path (project dir has spaces).
ExecStart=/home/javon/Desktop/Real\x20Estate\x20Website\x20Builder/bin/rails bok:sync
Nice=10
# Scraper is sequential with ~4s delay; 250 details can take ~30–40+ minutes.
# Address AI + listing copy + coord reconcile + staging push often need 1–2h.
TimeoutStartSec=3h
# After an intentional stop, allow in-flight OpenAI HTTP (90s read) to unwind
# before SIGKILL so the journal shows a clean SignalException rather than a hard kill.
TimeoutStopSec=3min

[Install]
WantedBy=default.target
