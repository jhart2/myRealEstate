<% content_for :title, "Profile & Experience" %>

<h1 class="font-display text-3xl font-light">Profile & experience</h1>
<p class="mt-1 text-sm text-ink-3">This information appears on your public agent page.</p>

<%= form_with model: agent, url: portal_profile_path, method: :patch, multipart: true, class: "mt-8 max-w-2xl space-y-5" do |f| %>
  <% if agent.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><%= agent.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field-group">
    <%= f.label :name, "Full name", class: "field-label" %>
    <%= f.text_field :name, placeholder: "Catherine Wells", class: "field", required: true %>
  </div>

  <div class="field-group">
    <%= f.label :title, "Title / specialty", class: "field-label" %>
    <%= f.text_field :title, placeholder: "Senior Property Advisor", class: "field", required: true %>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="field-group">
      <%= f.label :years_experience, "Years of experience", class: "field-label" %>
      <%= f.number_field :years_experience, placeholder: "20", min: 0, max: 80, class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :sales_volume, "Sales volume", class: "field-label" %>
      <%= f.text_field :sales_volume, placeholder: "$94M", class: "field" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="field-group">
      <%= f.label :email, "Public email", class: "field-label" %>
      <%= f.email_field :email, placeholder: "catherine@estate.realty", class: "field", required: true %>
    </div>
    <div class="field-group">
      <%= f.label :phone, class: "field-label" %>
      <%= f.telephone_field :phone, placeholder: "+1 (310) 555-0142", class: "field" %>
    </div>
  </div>

  <%= render "shared/image_upload", form: f, label: "Portrait photo", aspect: "portrait" %>

  <div class="field-group">
    <%= f.label :bio, class: "field-label" %>
    <%= f.text_area :bio, rows: 5, placeholder: "Your background, markets, and approach…", class: "field" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit "Save profile", class: "btn-primary cursor-pointer" %>
    <%= link_to "View public profile", agent_path(agent), class: "btn-ghost" %>
  </div>
<% end %>
