<% content_for :title, "Create Account" %>

<section class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-6 py-16">
  <noscript>
    <% if alert = flash[:alert] %>
      <p class="mb-5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <span class="section-eyebrow">Account</span>
    <h1 class="font-display mt-2 text-4xl font-light text-ink">Join TT Realty</h1>
    <p class="mt-2 text-sm text-ink-3">Save listings and hear from advisors faster.</p>

    <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-5" do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <div class="field-group">
        <%= f.label :name, "Full name", class: "field-label" %>
        <%= f.text_field :name, required: true, placeholder: "Jordan Lee", class: "field" %>
      </div>
      <div class="field-group">
        <%= f.label :email_address, "Email address", class: "field-label" %>
        <%= f.email_field :email_address, required: true, placeholder: "you@example.com", class: "field" %>
      </div>
      <div class="field-group">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, required: true, placeholder: "••••••••", maxlength: 72, class: "field" %>
      </div>
      <div class="field-group">
        <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
        <%= f.password_field :password_confirmation, required: true, placeholder: "••••••••", maxlength: 72, class: "field" %>
      </div>
      <%= f.submit "Create account", class: "btn-primary cursor-pointer" %>
    <% end %>

    <p class="mt-8 text-sm text-ink-3">
      Already have an account? <%= link_to "Sign in", new_session_path, class: "font-medium text-ink underline decoration-trinidad underline-offset-4" %>
    </p>
  </noscript>

  <div class="auth-page-fallback js-hide text-center">
    <span class="section-eyebrow">Account</span>
    <h1 class="font-display mt-2 text-4xl font-light text-ink">Join TT Realty</h1>
    <p class="mt-3 text-sm text-ink-3">Use the dialog to continue, or reload if it didn’t open.</p>
    <button type="button" class="btn-accent mt-8 cursor-pointer" data-action="auth-modal#open" data-auth-modal-mode-param="signup">
      Open create account
    </button>
  </div>
</section>
