<% cover = property.listing_cover_url %>
<article class="overflow-hidden rounded-xl border border-border bg-panel">
  <div class="aspect-[16/10] bg-panel-warm">
    <% if cover.present? %>
      <img src="<%= cover %>" alt="" class="h-full w-full object-cover">
    <% else %>
      <div class="flex h-full items-center justify-center text-sm text-ink-3">No photo</div>
    <% end %>
  </div>
  <div class="space-y-3 p-5">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-ink-3">Listing <%= side %></p>
        <h2 class="mt-1 font-display text-2xl font-light leading-snug"><%= property.title %></h2>
      </div>
      <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium <%= admin_status_badge_class(property.status) %>">
        <%= property.status %>
      </span>
    </div>

    <dl class="grid gap-2 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Price</dt>
        <dd class="font-medium"><%= number_to_currency(property.price_cents / 100.0, precision: 0) %><% if property.tag == "rent" %> / mo<% end %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Address</dt>
        <dd class="text-right"><%= property.full_address %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Beds / baths / sqft</dt>
        <dd><%= property.beds %> / <%= property.baths %> / <%= property.sqft.presence || "—" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Type / tag</dt>
        <dd><%= property.property_type %> · <%= property.tag %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Agent</dt>
        <dd><%= property.agent&.name.presence || "—" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Slug / BOK</dt>
        <dd class="text-right text-ink-3"><%= property.slug %> · <%= property.bok_id.presence || "—" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-ink-3">Flagged</dt>
        <dd><%= property.possible_duplicate? ? "Yes" : "No" %></dd>
      </div>
    </dl>

    <% features = Array(property.features).reject(&:blank?) %>
    <% if features.any? %>
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-ink-3">Features</p>
        <p class="mt-1 text-sm text-ink-2"><%= features.join(" · ") %></p>
      </div>
    <% end %>

    <% if property.description.present? %>
      <div class="border-t border-border pt-3">
        <p class="text-xs font-medium uppercase tracking-wider text-ink-3">Description</p>
        <div class="property-description trix-content mt-2 max-h-48 overflow-y-auto text-sm text-ink-2">
          <%= sanitize(property.description.to_s, tags: %w[div p br h2 h3 strong em ul ol li a], attributes: %w[href]) %>
        </div>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-3 border-t border-border pt-3">
      <%= link_to "Edit", edit_admin_property_path(property), class: "btn-secondary" %>
      <%= link_to "View on site", property_path(property), class: "btn-secondary", target: "_blank", rel: "noopener" %>
    </div>
  </div>
</article>
