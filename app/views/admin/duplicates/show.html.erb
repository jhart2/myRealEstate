<% content_for :title, "Reconcile duplicates" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <%= link_to "← Possible duplicates", admin_duplicates_path, class: "text-sm text-ink-3 hover:text-ink" %>
  <p class="text-sm text-ink-3">
    Match score <%= @score %>/4
    <% if @signals.any? %>
      · <%= @signals.join(", ") %>
    <% end %>
  </p>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%= render "panel", property: @left, side: "A" %>
  <%= render "panel", property: @right, side: "B" %>
</div>

<div class="mt-6 rounded-xl border border-border bg-panel p-6">
  <p class="text-sm text-ink-3">
    Resolve this pair, then the next both-flagged pair loads. Keeping one disables the other.
    Keep both clears flags without disabling. Cleared listings leave the queue and will not resurface with other flagged peers.
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <%= button_to "Keep A, disable B",
          admin_duplicate_path(@left, peer: @right.to_param),
          method: :patch,
          params: { reconcile: "keep_left" },
          class: "btn-primary cursor-pointer" %>
    <%= button_to "Keep B, disable A",
          admin_duplicate_path(@left, peer: @right.to_param),
          method: :patch,
          params: { reconcile: "keep_right" },
          class: "btn-primary cursor-pointer" %>
    <%= button_to "Keep both (clear flags)",
          admin_duplicate_path(@left, peer: @right.to_param),
          method: :patch,
          params: { reconcile: "keep_both" },
          class: "btn-secondary cursor-pointer" %>
    <%= button_to "Clear flag on A only",
          admin_duplicate_path(@left, peer: @right.to_param),
          method: :patch,
          params: { reconcile: "clear_left" },
          class: "btn-secondary cursor-pointer" %>
    <%= button_to "Clear flag on B only",
          admin_duplicate_path(@left, peer: @right.to_param),
          method: :patch,
          params: { reconcile: "clear_right" },
          class: "btn-secondary cursor-pointer" %>
  </div>
</div>
