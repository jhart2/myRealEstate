<% content_for :title, "Reconcile duplicates" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <%= link_to "← Possible duplicates", admin_duplicates_path, class: "text-sm text-ink-3 hover:text-ink" %>
  <p class="text-sm text-ink-3">
    Match score <%= @score %>/4
    <% if @signals.any? %>
      · <%= @signals.join(", ") %>
    <% end %>
  </p>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%= render "panel", property: @left, side: "A" %>
  <%= render "panel", property: @right, side: "B" %>
</div>

<%= form_with url: admin_duplicate_path(@left, peer: @right.to_param), method: :patch, class: "mt-6 rounded-xl border border-border bg-panel p-6" do %>
  <p class="text-sm text-ink-3">Choose how to resolve this pair. After you submit, the next flagged pair loads automatically. Keeping one disables the other and clears flags; keep both clears flags so both stay in search.</p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button type="submit" name="commit" value="keep_left" class="btn-primary cursor-pointer">Keep A, disable B</button>
    <button type="submit" name="commit" value="keep_right" class="btn-primary cursor-pointer">Keep B, disable A</button>
    <button type="submit" name="commit" value="keep_both" class="btn-secondary cursor-pointer">Keep both (clear flags)</button>
    <button type="submit" name="commit" value="clear_left" class="btn-secondary cursor-pointer">Clear flag on A only</button>
    <button type="submit" name="commit" value="clear_right" class="btn-secondary cursor-pointer">Clear flag on B only</button>
  </div>
<% end %>
