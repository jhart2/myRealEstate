<% content_for :title, @property.persisted? ? "Edit Property" : "New Property" %>

<h1 class="font-display text-3xl font-light"><%= @property.persisted? ? "Edit property" : "New property" %></h1>

<%= form_with model: [:admin, @property], multipart: true, class: "mt-8 max-w-2xl space-y-5" do |f| %>
  <% if @property.errors.any? %>
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><%= @property.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field-group">
    <%= f.label :title, class: "field-label" %>
    <%= f.text_field :title, placeholder: "Meridian House", class: "field", required: true %>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="field-group">
      <%= f.label :tag, "Listing type", class: "field-label" %>
      <%= f.select :tag, Property::TAGS.map { |t| [t.titleize, t] }, {}, class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :property_type, "Property type", class: "field-label" %>
      <%= f.select :property_type, Property::PROPERTY_TYPES, {}, class: "field" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="field-group">
      <%= f.label :status, class: "field-label" %>
      <%= f.select :status, Property::STATUSES.map { |s| [s.titleize, s] }, {}, class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :agent_id, "Assigned agent", class: "field-label" %>
      <%= f.collection_select :agent_id, @agents, :id, :name, { include_blank: "No agent" }, class: "field" %>
    </div>
  </div>

  <div class="field-group">
    <%= f.label :address, "Street address", class: "field-label" %>
    <%= f.text_field :address, placeholder: "12 Clifton Rise", class: "field", required: true %>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    <div class="field-group">
      <%= f.label :city, class: "field-label" %>
      <%= f.text_field :city, placeholder: "Beverly Hills", class: "field", required: true %>
    </div>
    <div class="field-group">
      <%= f.label :state, class: "field-label" %>
      <%= f.text_field :state, placeholder: "CA", class: "field", required: true %>
    </div>
    <div class="field-group">
      <%= f.label :zip, "ZIP code", class: "field-label" %>
      <%= f.text_field :zip, placeholder: "90210", class: "field" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-4">
    <div class="field-group">
      <%= f.label :price_cents, "Price (cents)", class: "field-label" %>
      <%= f.number_field :price_cents, placeholder: "475000000", class: "field", required: true %>
      <p class="field-hint">$4,750,000 = 475000000</p>
    </div>
    <div class="field-group">
      <%= f.label :beds, "Bedrooms", class: "field-label" %>
      <%= f.number_field :beds, placeholder: "5", class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :baths, "Bathrooms", class: "field-label" %>
      <%= f.number_field :baths, placeholder: "4", class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :sqft, "Home square feet", class: "field-label" %>
      <%= f.number_field :sqft, placeholder: "5820", class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :lot_sqft, "Lot square feet", class: "field-label" %>
      <%= f.number_field :lot_sqft, placeholder: "8000", class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :acres, "Acres", class: "field-label" %>
      <%= f.number_field :acres, step: :any, placeholder: "1.03", class: "field" %>
      <p class="field-hint">Filled automatically when derived from listing text / lot size</p>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="field-group">
      <%= f.label :latitude, class: "field-label" %>
      <%= f.number_field :latitude, step: :any, placeholder: "34.0901", class: "field" %>
    </div>
    <div class="field-group">
      <%= f.label :longitude, class: "field-label" %>
      <%= f.number_field :longitude, step: :any, placeholder: "-118.4065", class: "field" %>
      <p class="field-hint">Used for map search pins</p>
    </div>
  </div>

  <%= render "shared/image_upload", form: f, label: "Listing photo", aspect: "landscape" %>

  <div class="field-group">
    <%= f.label :description, class: "field-label" %>
    <%= f.text_area :description, rows: 5, placeholder: "Describe the property…", class: "field" %>
  </div>

  <label class="flex items-center gap-2 text-sm font-medium text-ink">
    <%= f.check_box :featured, class: "rounded border-border" %>
    Featured listing
  </label>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancel", admin_properties_path, class: "btn-ghost" %>
  </div>
<% end %>
