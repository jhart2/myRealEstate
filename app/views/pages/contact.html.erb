<% content_for :title, "Contact" %>

<section class="mx-auto max-w-3xl px-6 py-20">
  <span class="section-eyebrow">Get In Touch</span>
  <h1 class="font-display mt-2 text-4xl font-light text-ink md:text-5xl">Talk with an advisor</h1>
  <p class="mt-3 text-sm text-ink-3">Buying, renting, or listing — tell us what you need and we’ll route you to the right specialist.</p>

  <%= form_with model: @inquiry, url: inquiries_path, class: "mt-10 space-y-4 rounded-xl border border-border bg-panel p-6" do |f| %>
    <%= f.text_field :name, placeholder: "Full name", required: true, class: "field" %>
    <%= f.email_field :email, placeholder: "Email", required: true, class: "field" %>
    <%= f.telephone_field :phone, placeholder: "Phone", class: "field" %>
    <%= f.text_area :message, rows: 5, placeholder: "How can we help?", required: true, class: "field" %>
    <%= f.submit "Send message", class: "btn-accent cursor-pointer" %>
  <% end %>
</section>
