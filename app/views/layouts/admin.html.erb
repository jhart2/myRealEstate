<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Admin" : "Admin · TT Realty" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-[#f3f1ed] text-ink antialiased">
    <div class="flex min-h-screen">
      <aside class="admin-sidebar hidden w-60 shrink-0 flex-col bg-ink text-ground md:flex">
        <div class="border-b border-white/10 px-5 py-5">
          <%= link_to root_path, class: "inline-flex items-center gap-2" do %>
            <span class="font-display text-xl font-semibold tracking-tight">TT</span>
            <span class="mt-0.5 text-[11px] font-medium uppercase tracking-[0.22em] text-trinidad">Realty</span>
          <% end %>
        </div>

        <nav class="flex flex-1 flex-col gap-0.5 p-3 text-sm">
          <%= render "admin/shared/nav_link", label: "Dashboard", path: admin_root_path, section: :dashboard, icon: :dashboard %>
          <%= render "admin/shared/nav_link", label: "Properties", path: admin_properties_path, section: :properties, icon: :properties %>
          <%= render "admin/shared/nav_link", label: "Copy reviews", path: admin_copy_reviews_path, section: :copy_reviews, icon: :copy_reviews %>
          <%= render "admin/shared/nav_link", label: "Agents", path: admin_agents_path, section: :agents, icon: :agents %>
          <%= render "admin/shared/nav_link", label: "Inquiries", path: admin_inquiries_path, section: :inquiries, icon: :inquiries %>

          <%= link_to root_path, class: "mt-4 inline-flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-trinidad transition-colors hover:bg-white/10" do %>
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 5h5v5M10 14 19 5M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
            View site
          <% end %>
        </nav>

        <div class="mt-auto border-t border-white/10 p-3">
          <div class="mb-2 flex items-center gap-3 rounded-lg px-2 py-2">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-trinidad text-xs font-semibold text-white"><%= admin_user_initials %></span>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ground"><%= current_user.name %></p>
              <p class="text-xs text-ground/45">Administrator</p>
            </div>
          </div>
          <%= button_to session_path, method: :delete, class: "admin-sidebar-btn group flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2.5 text-left text-sm text-ground/65 transition-colors hover:bg-white/10 hover:text-ground" do %>
            <svg class="h-4 w-4 shrink-0 opacity-70 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            Sign out
          <% end %>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center justify-between gap-4 border-b border-border bg-panel px-6 py-3.5">
          <div class="min-w-0 text-sm text-ink-3">
            <%= content_for?(:admin_breadcrumb) ? yield(:admin_breadcrumb) : "Signed in as #{current_user.name}" %>
          </div>
          <div class="flex items-center gap-3">
            <%= link_to admin_copy_reviews_path, class: "relative inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-2 transition-colors hover:bg-panel-warm hover:text-ink", aria: { label: "Copy reviews" } do %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 12h6M9 16h4"/></svg>
              <% review_count = admin_copy_review_count %>
              <% if review_count.positive? %>
                <span class="absolute -right-0.5 -top-0.5 inline-flex min-w-[1.1rem] items-center justify-center rounded-full bg-amber-500 px-1 text-[10px] font-semibold leading-4 text-white"><%= review_count > 99 ? "99+" : review_count %></span>
              <% end %>
            <% end %>
            <%= link_to admin_inquiries_path, class: "relative inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-2 transition-colors hover:bg-panel-warm hover:text-ink", aria: { label: "Open inquiries" } do %>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
              <% open_count = admin_open_inquiry_count %>
              <% if open_count.positive? %>
                <span class="absolute -right-0.5 -top-0.5 inline-flex min-w-[1.1rem] items-center justify-center rounded-full bg-trinidad px-1 text-[10px] font-semibold leading-4 text-white"><%= open_count > 99 ? "99+" : open_count %></span>
              <% end %>
            <% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer text-sm font-medium text-ink-2 transition-colors hover:text-ink" %>
          </div>
        </header>

        <%= render "shared/flash" %>
        <div class="flex-1 p-6 md:p-8">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
