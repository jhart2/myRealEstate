<%# Airbnb-style auth modal — guest only (render from application layout). %>
<%
  auth_auto = @auth_modal_auto_open.presence || params[:auth].presence
  show_modal_alert = auth_auto.present? && flash[:alert].present?
%>
<div
  class="auth-modal hidden"
  data-auth-modal-target="overlay"
  data-action="click->auth-modal#closeOnBackdrop"
  role="presentation"
  aria-hidden="true"
>
  <div
    class="auth-modal-dialog"
    data-auth-modal-target="dialog"
    data-action="click->auth-modal#stop"
    role="dialog"
    aria-modal="true"
    aria-labelledby="auth-modal-heading"
  >
    <button
      type="button"
      class="auth-modal-close"
      data-action="auth-modal#close"
      aria-label="Close"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
      </svg>
    </button>

    <div class="auth-modal-brand">
      <span class="font-display text-2xl font-semibold tracking-tight text-ink">TT</span>
      <span class="mt-0.5 text-[10px] font-medium uppercase tracking-[0.22em] text-trinidad">Realty</span>
    </div>

    <h2 id="auth-modal-heading" class="auth-modal-heading font-display" data-auth-modal-target="heading">
      Log in or sign up
    </h2>
    <p class="auth-modal-subtext hidden" data-auth-modal-target="subtext" hidden></p>

    <p
      class="auth-modal-alert<%= ' hidden' unless show_modal_alert %>"
      data-auth-modal-target="alert"
      role="alert"
    ><%= flash[:alert] if show_modal_alert %></p>

    <%# —— Step 1: email —— %>
    <div data-auth-modal-target="emailStep">
      <form data-action="submit->auth-modal#continueWithEmail" class="auth-modal-form">
        <label class="sr-only" for="auth_modal_email">Email</label>
        <input
          id="auth_modal_email"
          type="email"
          name="email_address"
          data-auth-modal-target="emailInput"
          autocomplete="username"
          placeholder="Email"
          required
          class="auth-modal-field"
        >
        <button type="submit" class="btn-accent auth-modal-submit">Continue</button>
      </form>

      <div class="auth-modal-divider" aria-hidden="true"><span>or</span></div>

      <button type="button" class="auth-modal-secondary" data-action="auth-modal#showSignup">
        Create an account
      </button>
    </div>

    <%# —— Step 2: password (login) —— %>
    <div class="hidden" data-auth-modal-target="passwordStep">
      <button type="button" class="auth-modal-back" data-action="auth-modal#backToEmail">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
        </svg>
        <span>Back</span>
      </button>

      <%= form_with url: session_path, class: "auth-modal-form", html: { data: { turbo: true } } do |form| %>
        <%= hidden_field_tag :modal, "1" %>
        <label class="sr-only" for="auth_modal_password_email">Email</label>
        <%= form.email_field :email_address,
              id: "auth_modal_password_email",
              data: { auth_modal_target: "passwordEmail" },
              autocomplete: "username",
              required: true,
              class: "auth-modal-field auth-modal-field--readonly",
              readonly: true %>
        <label class="sr-only" for="auth_modal_password">Password</label>
        <%= form.password_field :password,
              id: "auth_modal_password",
              data: { auth_modal_target: "passwordInput" },
              autocomplete: "current-password",
              placeholder: "Password",
              required: true,
              maxlength: 72,
              class: "auth-modal-field" %>
        <button type="submit" class="btn-accent auth-modal-submit">Sign in</button>
      <% end %>

      <p class="auth-modal-switch">
        <%= link_to "Forgot password?", new_password_path, class: "auth-modal-link", data: { turbo: false } %>
      </p>
    </div>

    <%# —— Sign up —— %>
    <div class="hidden" data-auth-modal-target="signupStep">
      <button type="button" class="auth-modal-back" data-action="auth-modal#showLogin">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
        </svg>
        <span>Back</span>
      </button>

      <%= form_with model: User.new, url: registration_path, class: "auth-modal-form", html: { data: { turbo: true } } do |f| %>
        <%= hidden_field_tag :modal, "1" %>
        <label class="sr-only" for="auth_modal_name">Full name</label>
        <%= f.text_field :name, id: "auth_modal_name", required: true, placeholder: "Full name", autocomplete: "name", class: "auth-modal-field" %>
        <label class="sr-only" for="auth_modal_signup_email">Email</label>
        <%= f.email_field :email_address,
              id: "auth_modal_signup_email",
              data: { auth_modal_target: "signupEmail" },
              required: true,
              placeholder: "Email",
              autocomplete: "username",
              class: "auth-modal-field" %>
        <label class="sr-only" for="auth_modal_signup_password">Password</label>
        <%= f.password_field :password, id: "auth_modal_signup_password", required: true, placeholder: "Password", maxlength: 72, autocomplete: "new-password", class: "auth-modal-field" %>
        <label class="sr-only" for="auth_modal_signup_password_confirmation">Confirm password</label>
        <%= f.password_field :password_confirmation, id: "auth_modal_signup_password_confirmation", required: true, placeholder: "Confirm password", maxlength: 72, autocomplete: "new-password", class: "auth-modal-field" %>
        <button type="submit" class="btn-accent auth-modal-submit">Create account</button>
      <% end %>

      <div class="auth-modal-divider" aria-hidden="true"><span>or</span></div>

      <button type="button" class="auth-modal-secondary" data-action="auth-modal#showLogin">
        Log in instead
      </button>
    </div>
  </div>
</div>
