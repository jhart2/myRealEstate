<%# locals: (form:, label: "Photo", hint: nil, aspect: "landscape") %>
<%
  record = form.object
  current_src = record.try(:display_image_url)
  hint ||= "JPEG, PNG, or WebP · max 10MB"
  frame_class = aspect == "portrait" ? "h-56 w-44" : "aspect-[16/10] w-full"
%>
<div
  class="space-y-3"
  data-controller="image-upload"
  data-image-upload-existing-url-value="<%= current_src %>"
>
  <label class="block text-sm font-medium text-ink"><%= label %></label>

  <div class="<%= aspect == 'portrait' ? 'flex justify-start' : 'block' %>">
    <div
      class="group relative <%= frame_class %> cursor-pointer overflow-hidden rounded-xl border border-dashed border-border bg-panel-warm transition-colors hover:border-trinidad hover:bg-stone-light/30"
      data-image-upload-target="dropzone"
      data-action="dragover->image-upload#dragover dragleave->image-upload#dragleave drop->image-upload#drop click->image-upload#open"
    >
      <img
        src="<%= current_src %>"
        alt=""
        class="absolute inset-0 h-full w-full object-cover <%= 'hidden' unless current_src.present? %>"
        data-image-upload-target="preview"
        <% unless current_src.present? %>hidden<% end %>>

      <div
        class="absolute inset-0 flex flex-col items-center justify-center gap-2.5 px-5 text-center <%= 'hidden' if current_src.present? %>"
        data-image-upload-target="placeholder"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-panel text-ink-2 ring-1 ring-border">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </span>
        <div class="space-y-1">
          <p class="text-sm font-medium leading-none text-ink">Drop image here</p>
          <p class="text-xs leading-snug text-ink-3">or click to browse</p>
        </div>
      </div>

      <div
        class="pointer-events-none absolute inset-0 flex items-center justify-center bg-ink/50 opacity-0 transition-opacity group-hover:opacity-100 <%= 'hidden' unless current_src.present? %>"
        data-image-upload-target="overlay"
      >
        <p class="text-sm font-medium text-ground">Replace photo</p>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2">
      <button type="button" class="inline-flex h-9 items-center rounded-lg border border-border bg-panel px-3 text-xs font-medium text-ink transition-colors hover:border-ink/30 hover:bg-panel-warm" data-action="image-upload#open">
        Choose file
      </button>
      <button
        type="button"
        class="inline-flex h-9 items-center rounded-lg px-3 text-xs font-medium text-red-700 transition-colors hover:bg-red-50 <%= 'hidden' unless current_src.present? %>"
        data-image-upload-target="clearButton"
        data-action="image-upload#clear"
      >
        Remove
      </button>
    </div>
    <p class="text-xs text-ink-3" data-image-upload-target="meta"><%= hint %></p>
  </div>

  <%= form.file_field :image,
        accept: "image/jpeg,image/png,image/webp,image/gif",
        class: "sr-only",
        data: {
          image_upload_target: "input",
          action: "change->image-upload#changed"
        } %>

  <%= form.hidden_field :remove_image, value: "0", data: { image_upload_target: "removeField" } %>
</div>
