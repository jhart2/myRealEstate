<%# locals: (property:) %>
<% favorited = authenticated? && current_user.favorited?(property) %>
<div id="<%= dom_id(property, :lightbox_favorite) %>" class="property-lightbox-favorite">
  <% if authenticated? %>
    <% if favorited %>
      <%= button_to property_favorite_path(property),
            method: :delete,
            class: "property-lightbox-icon-btn is-saved",
            form: { class: "property-lightbox-icon-form", data: { turbo_stream: true } },
            params: { source: "lightbox" },
            aria: { label: "Remove from saved" } do %>
        <svg class="property-lightbox-icon-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      <% end %>
    <% else %>
      <%= button_to property_favorite_path(property),
            method: :post,
            class: "property-lightbox-icon-btn",
            form: { class: "property-lightbox-icon-form", data: { turbo_stream: true } },
            params: { source: "lightbox" },
            aria: { label: "Save home" } do %>
        <svg class="property-lightbox-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      <% end %>
    <% end %>
  <% else %>
    <button
      type="button"
      class="property-lightbox-icon-btn"
      data-action="listing-share#promptSignIn"
      aria-label="Sign in to save"
    >
      <svg class="property-lightbox-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
      </svg>
    </button>
  <% end %>
</div>
