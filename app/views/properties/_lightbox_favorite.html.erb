<%# locals: (property:) %>
<% favorited = authenticated? && current_user.favorited?(property) %>
<div id="<%= dom_id(property, :lightbox_favorite) %>">
  <% if authenticated? %>
    <% if favorited %>
      <%= button_to property_favorite_path(property),
            method: :delete,
            class: "property-lightbox-icon-btn is-saved",
            form: { class: "property-lightbox-icon-form" },
            params: { source: "lightbox" },
            aria: { label: "Remove from saved" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7-4.6-9.5-9.2C.8 8.2 2.4 5 6 5c2 0 3.2 1.2 4 2.2C10.8 6.2 12 5 14 5c3.6 0 5.2 3.2 3.5 6.8C19 16.4 12 21 12 21z"/></svg>
      <% end %>
    <% else %>
      <%= button_to property_favorite_path(property),
            method: :post,
            class: "property-lightbox-icon-btn",
            form: { class: "property-lightbox-icon-form" },
            params: { source: "lightbox" },
            aria: { label: "Save home" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-4.6-9.5-9.2C.8 8.2 2.4 5 6 5c2 0 3.2 1.2 4 2.2C10.8 6.2 12 5 14 5c3.6 0 5.2 3.2 3.5 6.8C19 16.4 12 21 12 21z"/></svg>
      <% end %>
    <% end %>
  <% else %>
    <button
      type="button"
      class="property-lightbox-icon-btn"
      data-action="property-lightbox#promptSignIn"
      aria-label="Sign in to save"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-4.6-9.5-9.2C.8 8.2 2.4 5 6 5c2 0 3.2 1.2 4 2.2C10.8 6.2 12 5 14 5c3.6 0 5.2 3.2 3.5 6.8C19 16.4 12 21 12 21z"/></svg>
    </button>
  <% end %>
</div>
