<% search_heading = property_search_heading(@location) %>
<% content_for :title, search_heading %>
<% content_for :meta_description, property_search_meta_description(location: @location, count: @total_count) %>
<% content_for :hide_footer, "1" %>

<section
  class="flex h-full min-h-0 flex-col bg-ground"
  data-controller="search-map property-lightbox"
  data-search-map-listings-value="[]"
  <% if @map_boundary.present? %>
    data-search-map-boundary-value="<%= ERB::Util.html_escape(@map_boundary.to_json) %>"
  <% elsif @map_viewport.present? %>
    data-search-map-viewport-value="<%= ERB::Util.html_escape(@map_viewport.to_json) %>"
  <% end %>
>
  <!-- Filters — Zillow-style exposed chip bar -->
  <div class="search-page-header relative z-40 shrink-0" data-controller="search-filters" aria-label="filters">
    <%= form_with url: properties_path, method: :get, class: "relative", data: { turbo: false, search_map_target: "form" } do %>
      <input type="hidden" name="north" value="<%= params[:north] %>" data-search-map-target="north">
      <input type="hidden" name="south" value="<%= params[:south] %>" data-search-map-target="south">
      <input type="hidden" name="east" value="<%= params[:east] %>" data-search-map-target="east">
      <input type="hidden" name="west" value="<%= params[:west] %>" data-search-map-target="west">

      <div class="search-filter-bar">
        <div
          class="search-filter-location"
          data-controller="location-autocomplete"
          data-location-autocomplete-auto-submit-value="true"
        >
          <label class="sr-only" for="search_location">Location</label>
          <input
            id="search_location"
            type="text"
            name="location"
            value="<%= @location %>"
            placeholder="Address, neighborhood, city…"
            autocomplete="off"
            class="search-filter-location-input"
            data-search-filters-target="locationInput"
            data-location-autocomplete-target="input"
            data-action="input->location-autocomplete#onInput input->search-filters#onLocationInput focus->location-autocomplete#onFocus blur->location-autocomplete#onBlur keydown->location-autocomplete#onKeydown"
          >
          <button
            type="button"
            class="search-filter-location-clear<%= " is-visible" if @location.present? %>"
            data-search-filters-target="clearBtn"
            data-action="search-filters#clearLocation"
            aria-label="Clear search text"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
          <button type="submit" class="search-filter-location-submit" aria-label="Submit Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <path d="m20 20-3.5-3.5"/>
            </svg>
          </button>
          <div
            class="location-ac-menu absolute left-0 right-0 top-full z-[60] mt-1.5 hidden"
            data-location-autocomplete-target="menu"
            hidden
          ></div>
        </div>

        <button
          type="button"
          class="search-filter-chip is-active"
          data-search-filters-target="chip"
          data-panel="intent"
          data-action="search-filters#toggle"
          aria-expanded="false"
        >
          <span data-search-filters-target="intentLabel"><%= search_intent_chip_label(@intent) %></span>
          <%= search_filter_chevron %>
        </button>

        <button
          type="button"
          class="search-filter-chip<%= " is-active" if search_price_filter_active?(@budget, @price_min, @price_max) %>"
          data-search-filters-target="chip"
          data-panel="price"
          data-action="search-filters#toggle"
          aria-expanded="false"
        >
          <span><%= search_price_chip_label(@budget, @price_min, @price_max) %></span>
          <%= search_filter_chevron %>
        </button>

        <button
          type="button"
          class="search-filter-chip<%= " is-active" if current_currency != MoneyDisplay::DEFAULT_CURRENCY %>"
          data-search-filters-target="chip"
          data-panel="currency"
          data-action="search-filters#toggle"
          aria-expanded="false"
          aria-label="Display currency <%= current_currency %>"
        >
          <span data-search-filters-target="currencyLabel"><%= current_currency %></span>
          <%= search_filter_chevron %>
        </button>

        <button
          type="button"
          class="search-filter-chip<%= " is-active" if @beds.present? || @baths.present? %>"
          data-search-filters-target="chip"
          data-panel="beds"
          data-action="search-filters#toggle"
          aria-expanded="false"
        >
          <span><%= search_beds_baths_chip_label(@beds, @baths) %></span>
          <%= search_filter_chevron %>
        </button>

        <button
          type="button"
          class="search-filter-chip<%= " is-active" if @property_types.any? %>"
          data-search-filters-target="chip"
          data-panel="type"
          data-action="search-filters#toggle"
          aria-expanded="false"
        >
          <span><%= search_property_type_chip_label(@property_types) %></span>
          <%= search_filter_chevron %>
        </button>

        <button
          type="button"
          class="search-filter-chip<%= " is-active" if search_more_filters_active?(sort: @sort, sqft_min: @sqft_min, sqft_max: @sqft_max, acres_min: @acres_min, days_max: @days_max, featured_only: @featured_only) %>"
          data-search-filters-target="chip"
          data-panel="more"
          data-action="search-filters#toggle"
          aria-expanded="false"
        >
          <svg class="search-filter-sliders" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h10"/>
            <path d="M4 12h16"/>
            <path d="M4 18h8"/>
            <circle cx="17" cy="6" r="2"/>
            <circle cx="10" cy="12" r="2"/>
            <circle cx="15" cy="18" r="2"/>
          </svg>
          <span>More Filters</span>
          <%= search_filter_chevron %>
        </button>

        <button
          type="button"
          class="search-filter-save"
          data-search-filters-target="chip"
          data-panel="save"
          data-action="search-filters#toggle"
          aria-expanded="false"
        >
          Save search
        </button>
      </div>

      <div class="search-filter-panels">
        <div class="search-filter-panel hidden" data-search-filters-target="panel" data-panel="intent">
          <p class="search-filter-panel-title">Listing type</p>
          <div class="search-filter-options">
            <% checked_intent = %w[sale rent new all].include?(@intent.to_s) ? @intent.to_s : "all" %>
            <% [["all", "All"], ["sale", "For sale"], ["rent", "For rent"], ["new", "New listings"]].each do |value, label| %>
              <label class="search-filter-option">
                <input type="radio" name="intent" value="<%= value %>" <%= "checked" if checked_intent == value %> data-action="change->search-filters#applyAndClose">
                <span><%= label %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div
          class="search-filter-panel search-filter-panel--price hidden"
          data-search-filters-target="panel"
          data-panel="price"
          data-controller="price-range"
          data-price-range-min-value="<%= @price_min.to_i %>"
          data-price-range-max-value="<%= @price_max.present? ? @price_max.to_i : -1 %>"
          data-price-range-buckets-value="<%= Property::PRICE_HISTOGRAM_BUCKETS %>"
          data-price-range-max-dollars-value="<%= Property::PRICE_HISTOGRAM_MAX_DOLLARS %>"
        >
          <fieldset class="price-range-fieldset">
            <legend class="search-filter-panel-title">Price Range</legend>

            <div class="price-range-tabs" role="tablist" aria-label="Price mode">
              <button
                type="button"
                class="price-range-tab is-active"
                role="tab"
                aria-selected="true"
                data-price-range-target="listTab"
                data-action="price-range#showList"
              >List Price</button>
              <button
                type="button"
                class="price-range-tab"
                role="tab"
                aria-selected="false"
                data-price-range-target="payTab"
                data-action="price-range#showPayment"
              >Monthly Payment</button>
            </div>

            <p class="price-range-hint" data-price-range-target="hint" hidden>
              Estimate uses 20% down, 30-year term, 5.5% interest (principal &amp; interest only).
            </p>

            <div class="price-range-chart">
              <div
                class="price-range-histogram is-loading"
                data-price-range-target="histogram"
                role="img"
                aria-label="Listing count by price"
              >
                <% Property::PRICE_HISTOGRAM_BUCKETS.times do |index| %>
                  <span
                    class="price-range-bar"
                    style="--bar-height: 0%"
                    data-bucket-index="<%= index %>"
                  ></span>
                <% end %>
              </div>

              <div class="price-range-slider">
                <div class="price-range-rail">
                  <div class="price-range-fill" data-price-range-target="fill"></div>
                </div>
                <input
                  type="range"
                  class="price-range-thumb price-range-thumb--min"
                  min="0"
                  max="52"
                  value="0"
                  aria-label="Minimum price"
                  data-price-range-target="minRange"
                  data-action="input->price-range#onMinSlide"
                >
                <input
                  type="range"
                  class="price-range-thumb price-range-thumb--max"
                  min="0"
                  max="52"
                  value="52"
                  aria-label="Maximum price"
                  data-price-range-target="maxRange"
                  data-action="input->price-range#onMaxSlide"
                >
              </div>
            </div>

            <div class="price-range-bounds">
              <label class="price-range-bound">
                <span class="sr-only">Minimum</span>
                <input
                  type="text"
                  class="price-range-bound-input"
                  inputmode="decimal"
                  autocomplete="off"
                  data-price-range-target="minDisplay"
                  data-action="change->price-range#onMinInput"
                >
              </label>
              <span class="price-range-dash" aria-hidden="true">–</span>
              <label class="price-range-bound">
                <span class="sr-only">Maximum</span>
                <input
                  type="text"
                  class="price-range-bound-input"
                  inputmode="decimal"
                  autocomplete="off"
                  data-price-range-target="maxDisplay"
                  data-action="change->price-range#onMaxInput"
                >
              </label>
            </div>

            <input type="hidden" name="price_min" value="<%= @price_min %>" data-price-range-target="minHidden">
            <input type="hidden" name="price_max" value="<%= @price_max %>" data-price-range-target="maxHidden">
          </fieldset>

          <button type="submit" class="search-filter-apply" data-action="search-filters#closeAll">Apply</button>
        </div>

        <div class="search-filter-panel search-filter-panel--currency hidden" data-search-filters-target="panel" data-panel="currency">
          <p class="search-filter-panel-title">Display currency</p>
          <p class="search-filter-currency-hint">Listing prices are stored in TT$. Switching currency converts for display only.</p>
          <div class="search-filter-options" role="radiogroup" aria-label="Display currency">
            <% MoneyDisplay::CURRENCIES.each do |code| %>
              <button
                type="button"
                class="search-filter-option search-filter-currency-option<%= " is-selected" if current_currency == code %>"
                role="radio"
                aria-checked="<%= current_currency == code %>"
                data-action="search-filters#setCurrency"
                data-currency="<%= code %>"
              >
                <span class="search-filter-currency-dot" aria-hidden="true"></span>
                <span><%= code %></span>
              </button>
            <% end %>
          </div>
        </div>

        <div class="search-filter-panel hidden" data-search-filters-target="panel" data-panel="beds">
          <p class="search-filter-panel-title">Beds & baths</p>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="field-label" for="search_beds">Beds</label>
              <select id="search_beds" name="beds" class="field">
                <option value="">Any</option>
                <% (1..6).each do |n| %>
                  <option value="<%= n %>" <%= "selected" if @beds.to_s == n.to_s %>><%= n %>+</option>
                <% end %>
              </select>
            </div>
            <div>
              <label class="field-label" for="search_baths">Baths</label>
              <select id="search_baths" name="baths" class="field">
                <option value="">Any</option>
                <% (1..5).each do |n| %>
                  <option value="<%= n %>" <%= "selected" if @baths.to_s == n.to_s %>><%= n %>+</option>
                <% end %>
              </select>
            </div>
          </div>
          <button type="submit" class="search-filter-apply" data-action="search-filters#closeAll">Apply</button>
        </div>

        <div class="search-filter-panel search-filter-panel--type hidden" data-search-filters-target="panel" data-panel="type">
          <p class="search-filter-panel-title">Property type</p>
          <div class="search-filter-type-box" role="group" aria-label="Property types">
            <% Property::PROPERTY_TYPES.each do |type| %>
              <label class="search-filter-check">
                <input
                  type="checkbox"
                  name="property_types[]"
                  value="<%= type %>"
                  <%= "checked" if @property_types.include?(type) %>
                >
                <span><%= type %></span>
              </label>
            <% end %>
          </div>
          <button type="submit" class="search-filter-apply" data-action="search-filters#closeAll">Apply</button>
        </div>

        <div
          id="more-filters"
          class="search-filter-panel search-filter-panel--more hidden"
          data-search-filters-target="panel"
          data-panel="more"
        >
          <div class="search-filter-more-header">
            <h2 class="search-filter-more-title">More Filters</h2>
          </div>

          <div class="search-filter-more-body">
            <section class="search-filter-section">
              <h3 class="search-filter-section-title">Sort</h3>
              <label class="sr-only" for="search_sort">Sort listings</label>
              <select
                id="search_sort"
                name="sort"
                class="field"
                data-action="change->search-filters#applyAndClose"
              >
                <option value="featured" <%= "selected" if @sort == "featured" %>>Homes for you</option>
                <option value="price_asc" <%= "selected" if @sort == "price_asc" %>>Price (low to high)</option>
                <option value="price_desc" <%= "selected" if @sort == "price_desc" %>>Price (high to low)</option>
                <option value="newest" <%= "selected" if @sort == "newest" %>>Newest</option>
              </select>
            </section>

            <section class="search-filter-section">
              <h3 class="search-filter-section-title">Square feet</h3>
              <div class="search-filter-range-row">
                <label class="search-filter-range-field">
                  <span class="sr-only">Minimum square feet</span>
                  <input
                    type="number"
                    name="sqft_min"
                    min="0"
                    step="50"
                    inputmode="numeric"
                    placeholder="Min"
                    value="<%= @sqft_min %>"
                    class="field"
                  >
                </label>
                <span class="search-filter-range-dash" aria-hidden="true">–</span>
                <label class="search-filter-range-field">
                  <span class="sr-only">Maximum square feet</span>
                  <input
                    type="number"
                    name="sqft_max"
                    min="0"
                    step="50"
                    inputmode="numeric"
                    placeholder="Max"
                    value="<%= @sqft_max %>"
                    class="field"
                  >
                </label>
              </div>
            </section>

            <section class="search-filter-section">
              <h3 class="search-filter-section-title">Lot size</h3>
              <label class="field-label" for="search_acres_min">Minimum acres</label>
              <select id="search_acres_min" name="acres_min" class="field">
                <option value="">Any</option>
                <% [["0.25", "¼ acre"], ["0.5", "½ acre"], ["1", "1+ acre"], ["2", "2+ acres"], ["5", "5+ acres"]].each do |value, label| %>
                  <option value="<%= value %>" <%= "selected" if @acres_min.to_s == value %>><%= label %></option>
                <% end %>
              </select>
            </section>

            <section class="search-filter-section">
              <h3 class="search-filter-section-title">Days on TT</h3>
              <label class="field-label" for="search_days_max">Listed within</label>
              <select id="search_days_max" name="days_max" class="field">
                <option value="">Any</option>
                <% [["1", "1 day"], ["7", "7 days"], ["14", "14 days"], ["30", "30 days"], ["90", "90 days"]].each do |value, label| %>
                  <option value="<%= value %>" <%= "selected" if @days_max.to_s == value %>><%= label %></option>
                <% end %>
              </select>
            </section>

            <section class="search-filter-section">
              <h3 class="search-filter-section-title">Status</h3>
              <label class="search-filter-check">
                <input type="checkbox" name="featured" value="1" <%= "checked" if @featured_only %>>
                <span>Featured only</span>
              </label>
            </section>
          </div>

          <div class="search-filter-more-footer">
            <button type="button" class="search-filter-reset" data-action="search-filters#resetAll">
              Reset all filters
            </button>
            <button type="submit" class="search-filter-apply search-filter-apply--inline" data-action="search-filters#closeAll">
              Apply
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <div class="search-filter-panels">
      <div class="search-filter-panel search-filter-panel--save hidden" data-search-filters-target="panel" data-panel="save">
        <p class="search-filter-panel-title">Save this search</p>
        <p class="text-xs text-ink-3">Get email alerts when new homes match<%= @location.present? ? " in #{@location}" : "" %>.</p>
        <%= form_with url: subscriptions_path, class: "mt-3 flex gap-2" do %>
          <input type="email" name="email" required placeholder="Email address" class="field flex-1" value="<%= current_user&.email_address %>">
          <button type="submit" class="search-filter-apply !mt-0 shrink-0 px-4">Save</button>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Mobile view toggle -->
  <div class="flex shrink-0 border-b border-border bg-panel lg:hidden">
    <button type="button" class="flex-1 py-2.5 text-sm font-semibold text-ink" data-search-map-target="listTab" data-action="search-map#showList">List</button>
    <button type="button" class="flex-1 py-2.5 text-sm font-medium text-ink-3" data-search-map-target="mapTab" data-action="search-map#showMap">Map</button>
  </div>

  <!-- Split pane -->
  <div class="relative z-0 flex min-h-0 flex-1">
    <!-- Results list -->
    <aside
      class="flex w-full min-h-0 flex-col border-r border-border bg-panel-warm lg:w-[440px] xl:w-[480px]"
      data-search-map-target="listPane"
    >
      <div class="flex shrink-0 flex-col gap-1 border-b border-border bg-panel px-4 py-3">
        <h1 class="search-title text-[0.95rem] font-semibold leading-snug tracking-tight text-ink sm:text-base">
          <%= search_heading %>
        </h1>
        <p class="text-sm text-ink-3" data-search-map-target="resultsCount">
          <%= pluralize(@total_count, "result") %>
        </p>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto" data-search-map-target="listScroll">
        <div
          class="divide-y divide-border<%= " hidden" unless @properties.any? %>"
          data-search-map-target="resultsList"
          data-page="<%= @page %>"
          data-total-pages="<%= @total_pages %>"
        >
          <% @properties.each do |property| %>
            <%= render "properties/search_card", property: property %>
          <% end %>
        </div>

        <div
          class="p-10 text-center<%= " hidden" if @properties.any? %>"
          data-search-map-target="listEmpty"
        >
          <p class="font-display text-2xl text-ink">No homes match</p>
          <p class="mt-2 text-sm text-ink-3">Try clearing filters or searching a wider area.</p>
          <%= link_to "Clear search", properties_path,
                class: "btn-primary mt-6",
                data: { turbo: false },
                onclick: "try{localStorage.removeItem('tt-realty-search-filters')}catch(e){}" %>
        </div>

        <div
          class="flex h-10 items-center justify-center<%= " hidden" unless @page < @total_pages %>"
          data-search-map-target="listSentinel"
          aria-hidden="true"
        >
          <span class="text-xs text-ink-3" data-search-map-target="listLoading" hidden>Loading more…</span>
        </div>
      </div>
    </aside>

    <!-- Map -->
    <div
      class="relative hidden min-h-0 flex-1 bg-stone-light lg:block"
      data-search-map-target="mapPane"
    >
      <div class="absolute inset-0 z-0" data-search-map-target="map"></div>

      <div
        class="absolute inset-0 z-[500] flex flex-col items-center justify-center gap-3 bg-stone-light"
        data-search-map-target="spinner"
        data-state="loading"
        role="status"
        aria-live="polite"
      >
        <div class="h-9 w-9 animate-spin rounded-full border-2 border-ink/15 border-t-ink" aria-hidden="true"></div>
        <p class="text-sm text-ink-3" data-search-map-spinner-label>Loading map…</p>
      </div>

      <div
        class="estate-basemap absolute bottom-4 left-4 z-[1000]"
        role="group"
        aria-label="Map type"
      >
        <button
          type="button"
          class="estate-basemap-btn is-active"
          data-basemap="streets"
          data-search-map-target="basemapButton"
          data-action="search-map#setBasemap"
          aria-pressed="true"
        >Streets</button>
        <button
          type="button"
          class="estate-basemap-btn"
          data-basemap="satellite"
          data-search-map-target="basemapButton"
          data-action="search-map#setBasemap"
          aria-pressed="false"
        >Satellite</button>
        <button
          type="button"
          class="estate-basemap-btn"
          data-basemap="terrain"
          data-search-map-target="basemapButton"
          data-action="search-map#setBasemap"
          aria-pressed="false"
        >Terrain</button>
        <button
          type="button"
          class="estate-basemap-btn"
          data-basemap="dark"
          data-search-map-target="basemapButton"
          data-action="search-map#setBasemap"
          aria-pressed="false"
        >Dark</button>
      </div>

      <% if @properties.any? && @properties.none? { |p| p.latitude.present? && p.longitude.present? } %>
        <div class="absolute inset-x-4 bottom-4 z-[1000] rounded-xl bg-panel/95 px-4 py-3 text-center text-sm text-ink-2 shadow-lg ring-1 ring-border">
          These listings need map coordinates. Add latitude/longitude in admin to pin them.
        </div>
      <% end %>
    </div>
  </div>

  <div
    class="property-lightbox hidden"
    data-property-lightbox-target="overlay"
    data-action="click->property-lightbox#closeOnBackdrop"
    aria-hidden="true"
  >
    <div
      class="property-lightbox-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Property details"
      data-action="click->property-lightbox#stop"
    >
      <%= turbo_frame_tag "property_lightbox", data: { property_lightbox_target: "frame" } %>
    </div>
  </div>
</section>
