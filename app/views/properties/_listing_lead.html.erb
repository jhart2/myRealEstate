<%# locals: (property:) %>
<div class="property-lightbox-overview">
  <div class="property-lightbox-overview-main">
    <div class="property-lightbox-status-row">
      <span class="property-lightbox-status">
        <span class="property-lightbox-status-dot <%= property.tag == 'sale' || property.tag == 'new' ? 'is-sale' : '' %>"></span>
        <%= property.tag_label %>
      </span>
      <% if property.status == "active" %>
        <span class="property-lightbox-active-led" title="Active listing" aria-label="Active listing"></span>
      <% end %>
    </div>
    <p class="property-lightbox-price"><%= property_money(property) %></p>
    <% if property.title.present? %>
      <h1 class="property-lightbox-title"><%= property.title %></h1>
    <% end %>
    <p class="property-lightbox-address"><%= property.full_address %></p>
  </div>

  <% if property_spec_present?(property.beds) || property_spec_present?(property.baths) || property_spec_present?(property.sqft) %>
    <div class="property-lightbox-specs" aria-label="Property details">
      <% if property_spec_present?(property.beds) %>
        <div class="property-lightbox-spec">
          <span class="property-lightbox-spec-value"><%= property.beds %></span>
          <span class="property-lightbox-spec-label">beds</span>
        </div>
      <% end %>
      <% if property_spec_present?(property.baths) %>
        <div class="property-lightbox-spec">
          <span class="property-lightbox-spec-value"><%= property.baths %></span>
          <span class="property-lightbox-spec-label">baths</span>
        </div>
      <% end %>
      <% if property_spec_present?(property.sqft) %>
        <div class="property-lightbox-spec">
          <span class="property-lightbox-spec-value"><%= number_with_delimiter(property.sqft) %></span>
          <span class="property-lightbox-spec-label">sqft</span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% if property.estimated_payment_label.present? %>
  <div
    class="property-lightbox-payment mt-3"
    title="Estimate assumes <%= (MortgageEstimate::DEFAULT_DOWN_PAYMENT_RATE * 100).to_i %>% down, <%= MortgageEstimate::DEFAULT_TERM_YEARS %> years, <%= (MortgageEstimate::DEFAULT_ANNUAL_RATE * 100).to_s.sub(/\.?0+$/, "") %>% interest. Principal &amp; interest only — not a loan offer."
  >
    <p class="property-lightbox-payment-est">
      <abbr class="property-lightbox-payment-abbr" title="Principal & interest estimate">Est.</abbr><span class="property-lightbox-payment-colon">:</span>
      <strong><%= property.estimated_payment_label %></strong>
    </p>
    <%= link_to "Get pre-qualified", contact_path, class: "property-lightbox-payment-cta", data: { turbo: false } %>
  </div>
<% end %>

<% if property.acreage_label.present? || property.property_type.present? %>
  <div class="property-lightbox-facts mt-4">
    <% if property.property_type.present? %>
      <div class="property-lightbox-fact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M4 20V10l8-6 8 6v10"/>
          <path d="M9 20v-6h6v6"/>
        </svg>
        <span><%= property.property_type %><%= property.tag == "sale" || property.tag == "new" ? ", residential" : "" %></span>
      </div>
    <% end %>
    <% if property.acreage_label.present? %>
      <div class="property-lightbox-fact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M4 18h16"/>
          <path d="M5 18V9l4 3 3-5 3 4 4-2v9"/>
          <circle cx="17" cy="7" r="1.4"/>
        </svg>
        <span><%= property.acreage_label %></span>
      </div>
    <% end %>
    <% if (per_sqft = property_money(property, format: :per_sqft)).present? %>
      <div class="property-lightbox-fact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M4 20V10l8-6 8 6v10"/>
          <path d="M12 8v4"/>
          <path d="M10.5 10h3"/>
        </svg>
        <%= per_sqft %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="property-lightbox-stats-wrap mt-4">
  <dl class="property-lightbox-stats">
    <div class="property-lightbox-stat">
      <dt class="sr-only">Time on market</dt>
      <dd>
        <strong><%= property.days_on_estate %></strong>
        <%= property.days_on_estate == 1 ? "day" : "days" %> on
        <span class="property-lightbox-stat-tip" title="Calendar days since this listing was published on TT Realty">TT</span>
      </dd>
    </div>
    <div class="property-lightbox-stat">
      <dt class="sr-only">Views</dt>
      <dd>
        <strong><%= number_with_delimiter(property.views_count) %></strong>
        <span class="property-lightbox-stat-tip" title="Unique sessions that opened this listing">views</span>
      </dd>
    </div>
    <div class="property-lightbox-stat">
      <dt class="sr-only">Saves</dt>
      <dd>
        <strong><%= number_with_delimiter(property.saves_count) %></strong>
        <span class="property-lightbox-stat-tip" title="Buyers who saved this home to favorites">saves</span>
      </dd>
    </div>
  </dl>
</div>
