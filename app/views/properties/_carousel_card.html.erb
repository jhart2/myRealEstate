<%# locals: (property:) %>
<article class="group min-w-0" data-carousel-card>
  <div class="relative mb-3 aspect-[20/19] overflow-hidden rounded-xl bg-stone-light">
    <%= link_to property_path(property), class: "block h-full w-full", tabindex: -1 do %>
      <img
        src="<%= property.display_image_url %>"
        alt="<%= property.title %>"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        loading="lazy">
    <% end %>

    <% if property.featured? %>
      <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-medium text-ink shadow-sm backdrop-blur-sm">
        Featured
      </span>
    <% end %>

    <% if authenticated? %>
      <% if current_user.favorited?(property) %>
        <%= button_to property_favorite_path(property), method: :delete, class: "absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)]", aria: { label: "Remove favorite" } do %>
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <% end %>
      <% else %>
        <%= button_to property_favorite_path(property), method: :post, class: "absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)]", aria: { label: "Save property" } do %>
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <% end %>
      <% end %>
    <% else %>
      <%= link_to new_session_path, class: "absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)]", aria: { label: "Sign in to save" } do %>
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
      <% end %>
    <% end %>
  </div>

  <%= link_to property_path(property), class: "block min-w-0" do %>
    <h3 class="truncate text-[15px] font-semibold leading-snug text-ink"><%= property.region_headline %></h3>
    <p class="mt-0.5 truncate text-[13px] leading-snug text-ink-3">
      <%= property.display_price %>
      <% if property.beds.present? %>
        <span aria-hidden="true"> · </span><%= property.beds %> bed<%= property.beds == 1 ? "" : "s" %>
      <% end %>
      <% if property.baths.present? %>
        <span aria-hidden="true"> · </span><%= property.baths %> bath<%= property.baths == 1 ? "" : "s" %>
      <% end %>
    </p>
  <% end %>
</article>
