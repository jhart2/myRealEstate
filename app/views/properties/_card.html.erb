<%# locals: (property:) %>
<article class="group overflow-hidden rounded-xl bg-panel shadow-[0_2px_12px_rgba(26,23,20,0.06)] transition-transform hover:-translate-y-1">
  <div class="relative aspect-[4/3] overflow-hidden bg-stone-light">
    <%= link_to property_path(property) do %>
      <img src="<%= property.display_image_url %>" alt="<%= property.title %>" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
    <% end %>

    <span class="absolute left-4 top-4 rounded px-2.5 py-1 text-xs font-semibold text-white <%= property.tag == 'sale' ? 'bg-trinidad' : 'bg-ink-2' %>">
      <%= property.tag_label %>
    </span>

    <% if authenticated? %>
      <% if current_user.favorited?(property) %>
        <%= button_to property_favorite_path(property), method: :delete, class: "absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-white/90", aria: { label: "Remove favorite" } do %>
          <svg class="h-4 w-4 text-trinidad" viewBox="0 0 24 24" fill="currentColor"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <% end %>
      <% else %>
        <%= button_to property_favorite_path(property), method: :post, class: "absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-white/90", aria: { label: "Save property" } do %>
          <svg class="h-4 w-4 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <% end %>
      <% end %>
    <% else %>
      <%= link_to new_session_path, class: "absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-white/90", aria: { label: "Sign in to save" } do %>
        <svg class="h-4 w-4 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
      <% end %>
    <% end %>
  </div>

  <div class="p-5">
    <%= link_to property_path(property), class: "block" do %>
      <div class="mb-1 flex items-start justify-between gap-2">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-ink-3"><%= property.property_type %></p>
          <h3 class="font-display mt-0.5 text-xl font-semibold text-ink"><%= property.title %></h3>
        </div>
        <p class="font-display shrink-0 text-lg font-semibold text-ink"><%= property.display_price %></p>
      </div>
      <p class="mb-4 text-sm text-ink-3"><%= property.full_address %></p>
      <% if property.feature_list.any? %>
        <div class="mb-4">
          <%= render "properties/feature_chips", property: property, limit: 3 %>
        </div>
      <% end %>
      <div class="flex items-center gap-4 border-t border-stone-light pt-4 text-sm text-ink-2">
        <span><%= property.beds %> bed</span>
        <span><%= property.baths %> bath</span>
        <span><%= number_with_delimiter(property.sqft) %> ft²</span>
      </div>
    <% end %>
  </div>
</article>
