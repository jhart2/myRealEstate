<%# locals: (property:, inquiry:) %>
<% has_photos = property.display_gallery_image_urls.any? %>
<% has_map = property.mappable? %>
<% default_media = has_photos ? "photos" : "map" %>
<article
  class="property-lightbox-panel"
  data-property-lightbox-detail
  data-listing-id="<%= property.id %>"
>
  <div class="property-lightbox-media">
    <div class="property-lightbox-media-tools">
      <button
        type="button"
        class="property-lightbox-icon-btn"
        data-action="property-lightbox#close"
        aria-label="Back to search"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <%= render "properties/media_actions", property: property %>
    </div>

    <% if has_photos %>
      <div data-media-panel="photos" class="property-lightbox-hero<%= " hidden" unless default_media == "photos" %>">
        <%= render "properties/gallery", property: property, variant: "lightbox" %>
      </div>
    <% end %>

    <% if has_map %>
      <div data-media-panel="map" class="property-lightbox-hero<%= " hidden" unless default_media == "map" %>">
        <div
          class="h-full w-full"
          data-detail-map
          data-lat="<%= property.latitude %>"
          data-lng="<%= property.longitude %>"
        ></div>
      </div>
    <% elsif !has_photos %>
      <div class="property-lightbox-hero">
        <div class="flex h-full items-center justify-center bg-stone-light text-sm text-ink-3">No media available</div>
      </div>
    <% end %>

    <% if has_photos && has_map %>
      <div class="property-lightbox-media-tabs" role="tablist" aria-label="Listing media">
        <button
          type="button"
          role="tab"
          class="property-lightbox-media-tab"
          data-media-tab
          data-action="property-lightbox#toggleMedia"
          aria-selected="false"
          aria-label="Show map"
        >
          <svg data-icon="map" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2c-3.3 0-6 2.6-6 5.8 0 4.4 6 11.2 6 11.2s6-6.8 6-11.2C18 4.6 15.3 2 12 2zm0 8.2a2.4 2.4 0 1 1 0-4.8 2.4 2.4 0 0 1 0 4.8z"/>
          </svg>
          <svg class="hidden" data-icon="photos" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h3l1.5-2h7L17 7h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z"/>
            <circle cx="12" cy="13" r="3.25"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>

  <div class="property-lightbox-body">
    <div class="property-lightbox-main">
      <%= render "properties/listing_lead", property: property %>

      <% if property.description.present? %>
        <div class="mt-6">
          <h2 class="font-display text-xl font-semibold text-ink">About this home</h2>
          <div class="property-description trix-content mt-3 text-sm leading-relaxed text-ink-2"><%= property.description %></div>
        </div>
      <% end %>

      <% groups = property.facts_and_features_groups %>
      <% if groups.any? %>
        <div class="mt-6">
          <%= render "properties/facts_and_features", property: property, groups: groups %>
        </div>
      <% end %>

      <div class="mt-6">
        <%= render "properties/listing_agent", agent: property.agent, compact: true %>
      </div>

      <div class="mt-6">
        <%= link_to "View full listing", property_path(property), class: "btn-accent w-full sm:w-auto", data: { turbo: false } %>
      </div>

      <div
        class="travel-times mt-6"
        data-controller="travel-times"
        <% if property.mappable? %>
          data-travel-times-lat-value="<%= property.latitude %>"
          data-travel-times-lng-value="<%= property.longitude %>"
        <% end %>
        data-action="location-autocomplete:selected->travel-times#destinationSelected"
      >
        <div class="travel-times-header">
          <h2 class="travel-times-title">Travel times</h2>
        </div>

        <% if property.mappable? %>
          <div class="travel-times-compose" data-travel-times-target="compose">
            <div
              class="travel-times-field"
              data-controller="location-autocomplete"
              data-location-autocomplete-auto-submit-value="false"
            >
              <span class="travel-times-car" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M5 16h14v2a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H8v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-2Z"/>
                  <path d="M5 16l1.2-5.2A2 2 0 0 1 8.1 9h7.8a2 2 0 0 1 1.9 1.8L19 16"/>
                  <path d="M7.5 19.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm9 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/>
                </svg>
              </span>
              <input
                type="text"
                class="travel-times-input"
                placeholder="Add a destination"
                autocomplete="off"
                data-travel-times-target="input"
                data-location-autocomplete-target="input"
                data-action="input->location-autocomplete#onInput focus->location-autocomplete#onFocus blur->location-autocomplete#onBlur keydown->location-autocomplete#onKeydown"
              >
              <div
                class="location-ac-menu absolute left-0 right-0 top-full z-[70] mt-1.5 hidden"
                data-location-autocomplete-target="menu"
                hidden
              ></div>
            </div>
            <p class="travel-times-status hidden" data-travel-times-target="status"></p>
          </div>

          <div class="travel-times-result hidden" data-travel-times-target="result">
            <div class="travel-times-card">
              <span class="travel-times-marker" aria-hidden="true">A</span>
              <div class="travel-times-card-copy">
                <p class="travel-times-card-to" data-travel-times-target="resultLabel">To destination</p>
                <p class="travel-times-card-mode">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M5 16h14v2a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H8v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-2Z"/>
                    <path d="M5 16l1.2-5.2A2 2 0 0 1 8.1 9h7.8a2 2 0 0 1 1.9 1.8L19 16"/>
                  </svg>
                  By car <strong data-travel-times-target="resultTime">—</strong>
                </p>
              </div>
              <button type="button" class="travel-times-edit" data-action="travel-times#edit" aria-label="Edit destination">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M12 20h9"/>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
                <span class="travel-times-edit-label">Edit</span>
              </button>
            </div>
            <button type="button" class="travel-times-add" data-action="travel-times#clear">
              <span class="travel-times-add-icon" aria-hidden="true">+</span>
              Add another destination
            </button>
          </div>
        <% else %>
          <p class="travel-times-unavailable">Map location unavailable for commute estimates.</p>
        <% end %>
      </div>
    </div>

    <aside class="property-lightbox-aside">
      <div class="space-y-3">
        <% if can_edit_listing?(property) %>
          <%= link_to listing_edit_path_for(property), class: "btn-accent flex w-full items-center justify-center gap-1.5", data: { turbo: false } do %>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            Edit listing
          <% end %>
        <% end %>
        <div class="rounded-xl border border-border bg-panel p-5">
          <h3 class="font-display text-lg font-semibold text-ink">Request a tour</h3>
          <p class="mt-1 mb-4 text-sm text-ink-3">An advisor will respond within one business day.</p>

          <%= form_with model: inquiry, url: inquiries_path, class: "space-y-3", data: { turbo: false } do |f| %>
            <%= f.hidden_field :property_id %>
            <%= f.hidden_field :agent_id, value: property.agent_id %>
            <%= f.text_field :name, placeholder: "Full name", required: true, class: "field" %>
            <%= f.email_field :email, placeholder: "Email", required: true, class: "field" %>
            <%= f.telephone_field :phone, placeholder: "Phone (optional)", class: "field" %>
            <%= f.text_area :message, placeholder: "I'm interested in this property…", rows: 3, required: true, class: "field" %>
            <%= f.submit "Send inquiry", class: "btn-accent w-full cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</article>
