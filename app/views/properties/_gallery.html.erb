<%# locals: (property:, variant: "lightbox") %>
<% urls = property.display_gallery_image_urls %>
<% side = urls.drop(1).first(4) %>
<% use_dots = urls.size.between?(2, 9) %>
<% if urls.any? %>
  <div
    class="listing-gallery listing-gallery--<%= variant %><%= " has-tiles" if side.any? %>"
    data-controller="listing-gallery"
    data-listing-gallery-index-value="0"
    data-listing-gallery-count-value="<%= urls.size %>"
    data-listing-gallery-slug-value="<%= property.slug %>"
  >
    <%# Desktop / tablet mosaic (hero + 2×2). Hidden on mobile via CSS. %>
    <div
      class="listing-gallery-stream"
      role="list"
      aria-label="Media gallery tiles"
    >
      <button
        type="button"
        class="listing-gallery-tile listing-gallery-tile--hero"
        role="listitem"
        data-listing-gallery-target="tile"
        data-index="0"
        data-src="<%= urls.first %>"
        data-action="listing-gallery#openViewer"
        aria-label="Photo 1"
      >
        <img src="<%= urls.first %>" alt="<%= property.title %>" loading="eager">
      </button>

      <% if side.any? %>
        <div class="listing-gallery-side" role="presentation">
          <% side.each_with_index do |url, i| %>
            <% index = i + 1 %>
            <% last_tile = i == side.length - 1 %>
            <button
              type="button"
              class="listing-gallery-tile<%= " listing-gallery-tile--see-all" if last_tile %>"
              role="listitem"
              data-listing-gallery-target="tile"
              data-index="<%= index %>"
              data-src="<%= url %>"
              data-action="listing-gallery#openViewer"
              aria-label="<%= last_tile && urls.size > 1 ? "See all #{urls.size} photos" : "Photo #{index + 1}" %>"
            >
              <img src="<%= url %>" alt="" loading="<%= i < 2 ? "eager" : "lazy" %>">
              <% if last_tile %>
                <span class="listing-gallery-see-all">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                  </svg>
                  See all <%= urls.size %> photos
                </span>
              <% end %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Mobile full-bleed panoramic slideshow. Hidden on desktop via CSS. %>
    <div class="listing-gallery-mobile">
      <div
        class="listing-gallery-track"
        data-listing-gallery-target="track"
        data-action="scroll->listing-gallery#onTrackScroll"
        role="list"
        aria-label="Property photo slideshow"
        tabindex="0"
      >
        <% urls.each_with_index do |url, index| %>
          <button
            type="button"
            class="listing-gallery-slide<%= " is-active" if index.zero? %>"
            role="listitem"
            data-listing-gallery-target="slide"
            data-index="<%= index %>"
            data-src="<%= url %>"
            data-action="pointerdown->listing-gallery#onSlidePointerDown pointerup->listing-gallery#onSlidePointerUp pointercancel->listing-gallery#onSlidePointerUp click->listing-gallery#onSlideClick"
            aria-label="Photo <%= index + 1 %> of <%= urls.size %>"
          >
            <img
              src="<%= url %>"
              alt="<%= index.zero? ? property.title : "" %>"
              loading="<%= index < 2 ? "eager" : "lazy" %>"
              draggable="false"
            >
          </button>
        <% end %>
      </div>

      <div class="listing-gallery-mobile-chrome">
        <button
          type="button"
          class="listing-gallery-all-photos<%= " hidden" unless urls.size > 1 %>"
          data-action="listing-gallery#openAllPhotos"
          aria-label="All photos"
          <%= "hidden" unless urls.size > 1 %>
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
          </svg>
          All photos
        </button>

        <% if urls.size > 1 %>
          <% if use_dots %>
            <div class="listing-gallery-dots" role="tablist" aria-label="Photo position">
              <% urls.each_with_index do |_url, index| %>
                <button
                  type="button"
                  class="listing-gallery-dot<%= " is-active" if index.zero? %>"
                  role="tab"
                  data-listing-gallery-target="dot"
                  data-index="<%= index %>"
                  data-action="listing-gallery#goToSlide"
                  aria-label="Go to photo <%= index + 1 %>"
                  aria-selected="<%= index.zero? %>"
                ></button>
              <% end %>
            </div>
          <% else %>
            <div class="listing-gallery-mobile-counter" data-listing-gallery-target="mobileCounter" aria-live="polite">
              1 / <%= urls.size %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div
      class="listing-gallery-viewer hidden"
      data-listing-gallery-target="viewer"
      data-action="click->listing-gallery#closeOnBackdrop"
      aria-hidden="true"
    >
      <div class="listing-gallery-viewer-dialog" data-action="click->listing-gallery#stop" role="dialog" aria-modal="true" aria-label="Photo gallery">
        <div class="listing-gallery-viewer-toolbar">
          <div class="listing-gallery-viewer-toolbar-start">
            <button type="button" class="listing-gallery-viewer-close" data-action="listing-gallery#closeViewer" aria-label="Close photo gallery">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              Close
            </button>
            <button type="button" class="listing-gallery-viewer-download" data-action="listing-gallery#downloadCurrent" aria-label="Download this photo" title="Download this photo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3v12"/>
                <path d="m7 10 5 5 5-5"/>
                <path d="M5 21h14"/>
              </svg>
            </button>
          </div>
          <span class="listing-gallery-viewer-counter" data-listing-gallery-target="counter">1 / <%= urls.size %></span>
        </div>

        <div class="listing-gallery-viewer-stage">
          <div
            class="listing-gallery-viewer-track"
            data-listing-gallery-target="viewerTrack"
            data-action="scroll->listing-gallery#onViewerTrackScroll"
            role="list"
            aria-label="Photo slideshow"
            tabindex="0"
          >
            <% urls.each_with_index do |url, index| %>
              <div
                class="listing-gallery-viewer-slide<%= " is-active" if index.zero? %>"
                role="listitem"
                data-listing-gallery-target="viewerSlide"
                data-index="<%= index %>"
                data-src="<%= url %>"
                data-download-path="<%= photo_download_property_path(property, index) %>"
              >
                <img
                  src="<%= url %>"
                  alt="<%= index.zero? ? property.title : "" %>"
                  class="listing-gallery-viewer-hero"
                  loading="<%= index < 2 ? "eager" : "lazy" %>"
                  draggable="false"
                >
                <div class="listing-gallery-viewer-watermark" aria-hidden="true">
                  <span class="listing-gallery-viewer-watermark-tt">TT</span>
                  <span class="listing-gallery-viewer-watermark-realty">Realty</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="listing-gallery-viewer-thumbs" role="list" aria-label="All photos">
          <% urls.each_with_index do |url, index| %>
            <button
              type="button"
              class="listing-gallery-viewer-thumb<%= " is-active" if index.zero? %>"
              role="listitem"
              data-listing-gallery-target="thumb"
              data-index="<%= index %>"
              data-src="<%= url %>"
              data-action="listing-gallery#select"
              aria-label="Photo <%= index + 1 %>"
              aria-current="<%= index.zero? ? "true" : "false" %>"
            >
              <img src="<%= url %>" alt="" loading="lazy">
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="flex h-full min-h-[12rem] items-center justify-center bg-stone-light text-sm text-ink-3">No photo available</div>
<% end %>
